<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TimberbornHD</AssemblyName>
    <RootNamespace>TimberbornHD</RootNamespace>
    <TimberbornGameDir Condition="'$(TimberbornGameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Timberborn</TimberbornGameDir>
    <TimberbornManagedDir>$(TimberbornGameDir)\Timberborn_Data\Managed</TimberbornManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Timberborn.ModManagerScene">
      <HintPath>$(TimberbornManagedDir)\Timberborn.ModManagerScene.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(TimberbornManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(TimberbornManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>

